{
	"name": "robo-editor",
	"homepage": "http://onsvisual.github.io/robo-editor/",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node ./scripts/js-fix",
		"build:preview": "cross-env PUBLIC_APP_ENV=preview vite build",
		"preview": "vite preview",
		"deploy": "gh-pages -d build -t",
		"lint": "prettier --ignore-path .gitignore --ignore-path .prettierignore --check --plugin-search-dir=. .",
		"format": "prettier --ignore-path .gitignore --ignore-path .prettierignore --write --plugin-search-dir=. ."
	},
	"devDependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/language": "^6.12.4",
		"@codemirror/legacy-modes": "^6.5.4",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.13",
		"@lezer/highlight": "^1.2.5",
		"@onsvisual/robo-utils": "^0.6.1",
		"@onsvisual/svelte-charts": "^0.4.11",
		"@sveltejs/adapter-static": "^3.0.0",
		"@sveltejs/kit": "^2.60.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"assert": "^2.1.0",
		"codemirror": "^6.0.2",
		"cross-env": "^7.0.3",
		"d3-dsv": "latest",
		"d3-format": "latest",
		"debounce": "^1.2.1",
		"document-schema.js": "^7.16.1",
		"gh-pages": "6.1.1",
		"highlight.js": "^11.7.0",
		"jszip": "^3.10.1",
		"markdown-codec": "^11.1.16",
		"node-html-markdown": "^1.3.0",
		"node-html-parser": "^6.1.5",
		"node-pandoc": "^0.3.0",
		"parse-color": "^1.0.0",
		"path-browserify": "^1.0.1",
		"prettier": "^3.9.5",
		"prettier-plugin-svelte": "^3.5.2",
		"process": "^0.11.10",
		"pug": "3.0.4",
		"rtf-codec": "^8.1.24",
		"svelte": "^5.55.8",
		"svelte-split-pane": "^0.1.2",
		"vite": "^7.3.6"
	}
}
